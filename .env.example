# Runtime environment selection
NODE_ENV=development
APP_ENV=local
APP_REVISION=local
# Coolify provides this predefined exact Git SHA to Compose and final image
# stages. Keep the local sentinel only outside deployed environments.
SOURCE_COMMIT=local
APP_BUILD_REVISION=local

# Increment 4: direct-to-creator tips remain disabled until a separate release gate.
TIP_PAYMENTS_MODE=disabled
# Increment 6: keep disabled until policy, delivery and dispute release gates are accepted.
# Cleanup keeps running while intake or payment confirmation is paused.
COMMISSION_INTAKE_MODE=disabled
COMMISSION_PAYMENTS_MODE=disabled
COMMISSION_SCAN_BATCH_SIZE=100
COMMISSION_SCAN_INTERVAL_MS=60000
COMMISSION_RECENT_AUTH_SECONDS=3600
COMMISSION_TOTP_AUTH_SECONDS=3600
COMMISSION_RATE_WINDOW_SECONDS=3600
COMMISSION_REQUEST_LIMIT=20
COMMISSION_COMMAND_LIMIT=120
COMMISSION_READ_LIMIT=300
COMMISSION_FILES_MODE=disabled
COMMISSION_FULFILLMENT_MODE=disabled
COMMISSION_RESOLUTION_MODE=disabled
COMMISSION_MESSAGE_LIMIT=60
COMMISSION_FILE_RETENTION_MODE=report_only
COMMISSION_FILES_S3_ENDPOINT=http://localhost:9090
COMMISSION_FILES_S3_REGION=us-east-1
COMMISSION_FILES_S3_ACCESS_KEY_ID=local-commission-files-key
COMMISSION_FILES_S3_SECRET_ACCESS_KEY=local-commission-files-secret
COMMISSION_FILES_QUARANTINE_BUCKET=pawket-commission-quarantine
COMMISSION_FILES_CLEAN_BUCKET=pawket-commission-clean
COMMISSION_FILES_S3_FORCE_PATH_STYLE=true
COMMISSION_FILES_CLAMD_HOST=localhost
COMMISSION_FILES_CLAMD_PORT=3310
# Amount bounds and suggested presets are managed by the owner dashboard in the database.
TIP_INTENT_TTL_SECONDS=86400
TIP_GUEST_RECEIPT_TTL_SECONDS=604800
TIP_RECENT_AUTH_SECONDS=3600
TIP_TOTP_AUTH_SECONDS=3600
TIP_RATE_WINDOW_SECONDS=3600
TIP_CREATE_IP_LIMIT=10
TIP_CREATE_CREATOR_LIMIT=100
TIP_RECEIPT_REQUEST_LIMIT=120
TIP_OPEN_IP_LIMIT=3
TIP_OPEN_CREATOR_LIMIT=1000
TIP_QUEUE_PAGE_SIZE=25
TIP_EXPIRY_BATCH_SIZE=100
TIP_EXPIRY_SCAN_INTERVAL_MS=60000

# Increment 5: optional SePay read-only OAuth; all production capabilities remain gated.
# Use test only with isolated non-production storage; live only with production.
# Blank optional credentials do not enable setup. Never put creator grants in env.
SEPAY_INGRESS_MODE=disabled
SEPAY_ENVIRONMENT=
SEPAY_OAUTH_CLIENT_ID=
SEPAY_OAUTH_CLIENT_SECRET=
SEPAY_OAUTH_REDIRECT_URI=
SEPAY_PROCESSING_BATCH_SIZE=25
SEPAY_PROCESSING_SCAN_INTERVAL_MS=30000
SEPAY_PROCESSING_MAX_ATTEMPTS=5

# Local service endpoints; replace only in an ignored .env file.
DATABASE_URL=postgresql://pawket:change-me@localhost:5432/pawket
VALKEY_URL=redis://localhost:6379

# Dummy 32-character token for local development only.
METRICS_TOKEN=01234567890123456789012345678901

# Increment 2 local-only identity and encryption controls. Replace every secret
# with an independently generated value before using staging or production.
APP_BASE_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Dedicated OIDC client required for interactive sign-in. Values below are
# deliberately non-functional fixtures; no production auth bypass exists.
OIDC_ISSUER=https://idp.example.invalid/application/o/pawket/
OIDC_CLIENT_ID=pawket-synthetic
OIDC_PROVIDER_REVISION=synthetic-v1
OIDC_CLIENT_SECRET=local-only-oidc-secret-000000000000000000
OIDC_ACCOUNT_PORTAL_URL=https://idp.example.invalid/if/user/
PII_ACTIVE_KEY_ID=local-pii-v1
PII_KEYRING_JSON={"local-pii-v1":"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE="}
PII_LOOKUP_HMAC_KEY=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=
SECURITY_EMAIL_ADAPTER=local
BOOTSTRAP_OWNER_EMAIL=owner@pawket.local

# External authentik owner recovery record. This never enables a local factor
# reset or password fallback. Record acceptance and rehearsal before cutover.
OIDC_OWNER_RECOVERY_MODE=disabled
OIDC_OWNER_RECOVERY_ACCEPTANCE_REFERENCE=
OIDC_OWNER_RECOVERY_REHEARSED_AT=

# Production worker only. Set SECURITY_EMAIL_ADAPTER=smtp and provide all
# fields below through the deployment secret/environment manager. Use
# starttls for explicit TLS (usually 587) or tls for implicit TLS (usually 465).
SMTP_HOST=
SMTP_PORT=
SMTP_TLS_MODE=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Creator verification-transfer and immutable VN business-calendar inputs.
VERIFICATION_DEPOSIT_AMOUNT_VND=1000
OPERATING_BANK_BIN=000000
OPERATING_BANK_ACCOUNT_NUMBER=000000
OPERATING_BANK_ACCOUNT_NAME=PAWKET LOCAL ONLY
VN_BUSINESS_CALENDAR_VERSION=vn-local-v1
VN_BUSINESS_HOLIDAYS=[]

# Explicit authentication control lifetimes.
AUTH_USER_ABSOLUTE_TTL_SECONDS=2592000
AUTH_USER_IDLE_TTL_SECONDS=604800
AUTH_OWNER_ABSOLUTE_TTL_SECONDS=43200
AUTH_OWNER_IDLE_TTL_SECONDS=1800
AUTH_PRIMARY_STEP_UP_TTL_SECONDS=3600
AUTH_OWNER_TOTP_STEP_UP_TTL_SECONDS=3600

# Runtime tuning
LOG_LEVEL=info
PORT=3000
WORKER_CONCURRENCY=10
WORKER_TELEMETRY_PORT=9464
RETENTION_MODE=report_only
RETENTION_POLICY_VERSION=
RETENTION_APPROVED_AT=
RETENTION_ENFORCEMENT_PAUSED=true
RETENTION_BATCH_SIZE=100
RETENTION_SCAN_INTERVAL_MS=21600000
# Increment 3 publishing is deliberately disabled. These local-only object-store
# values exercise the adapter contract, not production bucket or IAM policy.
CREATOR_PUBLISHING_MODE=disabled
PUBLIC_MEDIA_S3_ENDPOINT=http://localhost:9090
PUBLIC_MEDIA_S3_REGION=us-east-1
PUBLIC_MEDIA_S3_ACCESS_KEY_ID=local-media-access-key
PUBLIC_MEDIA_S3_SECRET_ACCESS_KEY=local-media-secret-key
PUBLIC_MEDIA_QUARANTINE_BUCKET=pawket-media-quarantine
PUBLIC_MEDIA_DERIVATIVE_BUCKET=pawket-media-derivatives
PUBLIC_MEDIA_S3_FORCE_PATH_STYLE=true
PUBLIC_MEDIA_PROCESSING_CONCURRENCY=2
PUBLIC_MEDIA_CLEANUP_SCAN_INTERVAL_MS=21600000
PUBLIC_MEDIA_RETENTION_MODE=report_only
PUBLIC_MEDIA_RETENTION_ACCEPTANCE_REFERENCE=
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_MS=30000
