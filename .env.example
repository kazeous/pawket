# Runtime environment selection
NODE_ENV=development
APP_ENV=local
APP_REVISION=local

# Local service endpoints; replace only in an ignored .env file.
DATABASE_URL=postgresql://pawket:change-me@localhost:5432/pawket
VALKEY_URL=redis://localhost:6379

# Dummy 32-character token for local development only.
METRICS_TOKEN=01234567890123456789012345678901

# Increment 2 local-only identity and encryption controls. Replace every secret
# with an independently generated value before using staging or production.
APP_BASE_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000
BETTER_AUTH_SECRETS=["local-only-better-auth-secret-000000000000"]
PII_ACTIVE_KEY_ID=local-pii-v1
PII_KEYRING_JSON={"local-pii-v1":"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE="}
PII_LOOKUP_HMAC_KEY=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=
SECURITY_EMAIL_ADAPTER=local
BOOTSTRAP_OWNER_EMAIL=owner@pawket.local

# Optional OAuth providers. Each provider must be configured as a complete pair.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Creator verification-transfer and immutable VN business-calendar inputs.
VERIFICATION_DEPOSIT_AMOUNT_VND=1000
OPERATING_BANK_BIN=000000
OPERATING_BANK_ACCOUNT_NUMBER=000000
OPERATING_BANK_ACCOUNT_NAME=PAWKET LOCAL ONLY
VN_BUSINESS_CALENDAR_VERSION=vn-local-v1
VN_BUSINESS_HOLIDAYS=[]

# Explicit authentication control lifetimes.
AUTH_USER_ABSOLUTE_TTL_SECONDS=2592000
AUTH_USER_IDLE_TTL_SECONDS=604800
AUTH_OWNER_ABSOLUTE_TTL_SECONDS=43200
AUTH_OWNER_IDLE_TTL_SECONDS=1800
AUTH_MFA_PENDING_TTL_SECONDS=600
AUTH_PRIMARY_STEP_UP_TTL_SECONDS=900
AUTH_OWNER_TOTP_STEP_UP_TTL_SECONDS=300
AUTH_TOTP_MAX_FAILED_ATTEMPTS=5
AUTH_TOTP_LOCKOUT_SECONDS=900
AUTH_PASSWORD_RESET_TTL_SECONDS=1800

# Runtime tuning
LOG_LEVEL=info
PORT=3000
WORKER_CONCURRENCY=10
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_MS=30000
